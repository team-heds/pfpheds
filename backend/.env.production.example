# Configuration de production pour PFP HEdS Backend
# Copiez ce fichier vers .env.production et configurez les valeurs

# Environnement
NODE_ENV=production
PORT=3000

# Base de données Supabase (PRIORITAIRE)
VITE_SUPABASE_URL=https://api2.hedsvs.ch/rest/v1
VITE_SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OpenAI API (pour le chat)
OPENAI_API_KEY=your_openai_api_key_here

# Base de données Firebase (LEGACY - si encore utilisé)
FIREBASE_PROJECT_ID=pfpheds-default-rtdb
FIREBASE_DATABASE_URL=https://pfpheds-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=pfpheds-default-rtdb.firebaseapp.com
FIREBASE_STORAGE_BUCKET=pfpheds-default-rtdb.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_APP_ID=your_app_id_here

# Configuration CORS
CORS_ORIGIN=https://hedsvs.ch,https://www.hedsvs.ch
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Configuration de sécurité
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
SESSION_SECRET=your_super_secret_session_key_here_change_in_production
BCRYPT_ROUNDS=12

# Configuration des logs
LOG_LEVEL=info
LOG_FILE=/app/logs/backend.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Configuration des uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_PATH=/app/uploads

# Configuration de monitoring
HEALTH_CHECK_ENDPOINT=/health
METRICS_ENDPOINT=/metrics
ENABLE_MONITORING=true
AUTH_UPSTREAM_TIMEOUT_MS=2500
# Laisser à 0 pour une révocation immédiate des permissions. Maximum applicatif: 5000 ms.
AUTHORIZATION_CACHE_TTL_MS=0
READINESS_TIMEOUT_MS=1500

# Configuration de cache (si Redis utilisé)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Configuration email (si notifications email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Configuration gamification
GAMIFICATION_ENABLED=true
XP_MULTIPLIER=1.0
BADGE_NOTIFICATIONS=true
QUEST_AUTO_ASSIGN=true

# Configuration de rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESSFUL=true

# URL serveur autorisée pour les emails de récupération (jamais fournie par le navigateur)
PASSWORD_RECOVERY_REDIRECT_URL=https://hedsvs.ch/reset-password?flow=recovery
