# Gemini API Key (required for CareConvers intent classification)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
# Server only. Never expose this value through a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-side integrations
VIMEO_ACCESS_TOKEN=your_vimeo_access_token
GITHUB_TOKEN=your_github_fine_grained_token
GITHUB_ALLOWED_REPOSITORIES=team-heds/pfpheds

# Encrypted file transfer (FTPS by default, or SFTP)
FTP_PROTOCOL=ftps
FTP_HOST=your_ftp_host
FTP_PORT=21
FTP_USER=your_ftp_user
FTP_PASSWORD=your_ftp_password
FTP_SECURE=true
FTP_REJECT_UNAUTHORIZED=true
FTP_BASE_DIR=uploads

# Environment
NODE_ENV=development

# Port
PORT=3000
