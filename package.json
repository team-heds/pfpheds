{
  "name": "PlateformeFP",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "presentation:dev": "npm --prefix presentation run dev",
    "presentation:build": "npm --prefix presentation run build",
    "presentation:pdf": "npm --prefix presentation run pdf",
    "presentation:pdf:agents": "npm --prefix presentation run pdf:agents",
    "presentation:pdf:all": "npm --prefix presentation run pdf:all",
    "presentation:new": "node scripts/create-reveal-presentation.mjs",
    "presentation:test": "npm --prefix presentation run test",
    "docs:dev": "npm --prefix documentation run start",
    "docs:build": "npm --prefix documentation run build",
    "docs:serve": "npm --prefix documentation run serve",
    "build:all": "npm run build && npm run docs:build && node scripts/copy-docs-to-dist.js && npm run presentation:pdf:all && node scripts/copy-presentation-to-dist.js",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "debug-watch": "node debug-watch.js",
    "test": "npm run presentation:test",
    "test:unit": "vitest --run",
    "test:security": "npm --prefix backend test",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.8",
    "@fullcalendar/vue3": "^6.1.19",
    "@supabase/supabase-js": "^2.52.0",
    "@tiptap/core": "^2.22.3",
    "@tiptap/extension-image": "^2.22.3",
    "@tiptap/extension-link": "^2.22.3",
    "@tiptap/extension-placeholder": "^2.22.3",
    "@tiptap/extension-table": "^2.22.3",
    "@tiptap/extension-table-cell": "^2.22.3",
    "@tiptap/extension-table-header": "^2.22.3",
    "@tiptap/extension-table-row": "^2.22.3",
    "@tiptap/extension-task-item": "^2.22.3",
    "@tiptap/extension-task-list": "^2.22.3",
    "@tiptap/extension-text-align": "^2.22.3",
    "@tiptap/extension-underline": "^2.22.3",
    "@tiptap/pm": "^2.22.3",
    "@tiptap/starter-kit": "^2.22.3",
    "@tiptap/vue-3": "^2.22.3",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "dompurify": "^3.3.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.17.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "marked": "^4.3.0",
    "pinia": "^3.0.3",
    "primeflex": "^3.3.1",
    "primeicons": "^6.0.1",
    "primevue": "^3.52.0",
    "qrcode": "^1.5.4",
    "three": "^0.172.0",
    "vue": "^3.4.21",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@rushstack/eslint-patch": "^1.3.3",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "firebase-admin": "^11.10.1",
    "firebase-tools": "^13.0.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.0.3",
    "rollup": "^4.28.0",
    "sass": "^1.62.1",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.1.6",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
